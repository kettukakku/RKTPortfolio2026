---
import BaseLayout from "../layouts/BaseLayout.astro";
import categories from '../data/categories.ts';
---

<BaseLayout>
	<div class="carousel"> 
		<!-- ART Need to create a graphic for this. -->
	</div>
	<div class="container">
		<div class="categories">
			{categories.map((category) => (
				<a href={`portfolio#${category.id}`} class="category-card" style={`background-image: url('${category.image}');`}>
					<p class="category-text">{category.name}</p>
				</a>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	.carousel {
		height: 300px;
		background-color: var(--black);
		margin-bottom: 50px;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem;
	}
	.categories {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
	}
	.category-card {
		padding: 0.5rem 1.5rem;
		width: 300px;
		box-shadow: 2px 2px 10px var(--black);
		text-align: center;
		border: 5px solid transparent;
		transition: border-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
	}
	.category-card:hover {
		border-color: var(--accent);
		cursor: pointer;
		box-shadow: 2px 2px 10px var(--gray);
	}
	.category-text {
		font-size: 1.5rem;
		font-weight: 100;
		color: var(--gray-900, #1a1a1a);
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-family: "Anonymous Pro", monospace; 
</style>
