---
import stories, { Genre } from '../../data/stories.ts';
---

<div class="container">
    {Object.values(Genre).map((genre) => (
        <div>
            <h2 class="genre-label">{genre}</h2>
            <div class="stories-grid">
                {stories
                    .filter((story) => story.genre === genre)
                    .map((story) => (
                        <a href={`stories/${story.slug}`} class="story-card" style={`background-image: url('${story.coverImage}');`}>
                            <div class="story-card-content">
                                <h3 class="story-title">{story.title}</h3>
                                <p class="story-blurb">{story.description}</p>
                            </div>
                        </a>
                    ))}
            </div>
        </div>
    ))}
</div>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
    }
    .genre-label {
    background: var(--accent);
    padding: 0.5rem 1rem;
    text-transform: uppercase;
    font-family: var(--display-font);
    color: white;
    }
    .stories-grid {
        display: flex;
		justify-content: center;
		gap: 1.5rem;
    }
    .story-card {
        padding: 0.5rem;
        width: 200px;
        height: 200px;
        text-align: center;
        border: 2px solid black;
        transition: border-color 0.1s ease-in-out;
        position: relative;
        background-size: cover;
        background-position: center;
    }
    .story-card:hover {
        border-color: var(--accent);
        cursor: pointer;
    }
    .story-card-content {
        height: 100%;
    }
    .story-title,
    .story-blurb {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        width: 90%;
        transition: opacity 0.5s;
    }
    .story-title {
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-family: var(--display-font);
        opacity: 1;
    }
    .story-blurb {
        font-family: var(--paragraph-font);
        opacity: 0;
        visibility: hidden;
    }
    .story-card:hover .story-title {
        opacity: 0;
        visibility: hidden;
    }
    .story-card:hover .story-blurb {
        opacity: 1;
        visibility: visible;
    }
        
</style>