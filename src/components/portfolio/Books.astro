---
import books from "../../data/books"
---

<div class="container">
    {books.map((book) => (
        <div class="book-section">
            <img src={book.coverImage} alt={`Cover of ${book.title}`} class="book-cover" />
            <div class="book-details">
                <h3 class="book-title">{book.title}</h3>
                <p class="book-genre">{book.genre}</p>
                <p class="book-blurb">{book.blurb}</p>
            </div>
        </div>
    ))}
</div>

<!-- TODO alternate so the cover is on the oppsite side every other element -->
<style>
    .container {
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
        padding: 30px;
    }
    .book-section {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 30px;
    }
    .book-section:nth-child(even) {
        flex-direction: row-reverse;
    }
    .book-cover {
         width: 279px;
        height: 445px;
        border-color: black;
        border-width: 2px;
        border-style: solid;
    }
    .book-details {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 300px;
        padding: 0 50px;
    }
    .book-title {
        font-size: 1.4em;
        margin: 0;
    }
    .book-author {
        font-weight: bold;
        margin-bottom: -10px;
    }
    .book-genre {
        font-style: italic;
        color: #666;
        margin-bottom: 5px;
    }
    .book-blurb {
        font-size: 0.9em;
        color: #333;
        text-align: center;
        white-space: pre-line;
    }
</style>
