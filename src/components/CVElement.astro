---
const { company, parentCompany, position, period, description } = Astro.props;
---

<div class="element-container">
    <h3 class="job-title">
        {company} {parentCompany && `(${parentCompany})`}
    </h3>
    <div class="job-details">
        <p>{position}</p>
        <p>{period}</p>
    </div>
    {description && <p class="description">{description}</p>}
</div>

<style>
    .element-container {
        margin-bottom: 2rem;
    }
    .job-title {
        font-weight: bold;
        font-size: 1.25rem;
        letter-spacing: 0.1em;
        margin:  0.5rem 0;
        font-family: var(--display-font);
    }
    .job-details p {
        margin: 0;
        font-style: italic;
        font-size: 1rem;
        font-family: var(--paragraph-font);
    }
    .description {
        margin-top: 0.5rem;
        line-height: 1.4;
        font-family: var(--paragraph-font);
    }
    </style>